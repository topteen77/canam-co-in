# =============================================================================
# Rakesh CRM — project-wide environment (single source of truth)
# Copy to .env and edit. Paths below are relative to the project root (myapp/).
# =============================================================================

# --- Website / Deploy (dynamic globals) ---
DOCKER_NAME=rakesh-crm
DB_DATA_DIR=../db-data
SQL_DUMP_PATH=../db_nod_crm.sql

FRONTEND_HOST=localhost
FRONTEND_PORT=3000
BACKEND_HOST=localhost
# Backend HTTP port (Express). Used by server and deploy URLs.
PORT=5001

# phpMyAdmin (Docker UI for MySQL). Default 8081 — 8080 often used by other apps.
PHPMYADMIN_PORT=8081
PUBLIC_PHPMYADMIN_URL=http://localhost:8081

PUBLIC_FRONTEND_URL=http://localhost:3000
PUBLIC_BACKEND_URL=http://localhost:5001
# Browser-facing API base (must include /api). Vite exposes VITE_* to the client.
VITE_API_URL=http://localhost:5001/api
PUBLIC_SITE_ORIGIN=http://localhost:3000
# Comma-separated hosts allowed by Vite / CORS helpers
ALLOWED_HOSTS=localhost,127.0.0.1,canam.co.in

# Gemini (optional AI features)
GEMINI_API_KEY=your_gemini_api_key_here

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=phpadmin
DB_PASSWORD=your_mysql_password
DB_NAME=db_nod_crm

# --- Firebase Admin SDK (Google Sign-In) ---
FIREBASE_PROJECT_ID=agent-follow-up-crm
FIREBASE_PRIVATE_KEY_ID=your_private_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@agent-follow-up-crm.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your_client_id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token

# --- Server ---
NODE_ENV=development

# --- Email (optional) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
# SMTP_FROM="CRM" <your-email@gmail.com>

# --- Admin ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- Security ---
JWT_SECRET=your-super-secret-jwt-key
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
